      "updated": 1783777334108,
      "link": null,
      "locked": false,
      "text": "In \"Mock MVC\" mode, the testing client (MockMvcTester or\nother) calls the Spring dispatcher servlet, and ultimately,\nyour controller methods directly (@GetMapping, ...), without\ngoing over the network",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In \"Mock MVC\" mode, the testing client (MockMvcTester or other) calls the Spring dispatcher servlet, and ultimately, your controller methods directly (@GetMapping, ...), without going over the network",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
